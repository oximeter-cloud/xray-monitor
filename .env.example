# Remnawave Panel REST API Configuration
REMNAWAVE_API_URL=https://panel.example.com/api
REMNAWAVE_API_TOKEN=your_remnawave_bearer_token_here

# Telemetry Ingestion Secret (shared between monitor and xray-monitor-node agents)
INGEST_SECRET=your_secure_random_ingest_secret_here

# Server Port
PORT=9922

# Path to database directory (defaults to /app/data in Docker or ./data locally)
DATA_DIR=/app/data

# Optional comma-separated list of user IDs to exclude from traffic analytics
# EXCLUDED_USER_IDS=104
